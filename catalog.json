{
  "schemaVersion": 1,
  "catalogVersion": "2026.10.03.1",
  "connectors": [
    {
      "id": "jira-dc",
      "displayName": "Jira Data Center",
      "vendor": "Atlassian",
      "status": "experimental",
      "summary": "Search, read and (if allowed) comment on and create Jira issues.",
      "notes": "Personal access tokens need Jira 8.14+. Users act with their own permissions when they store their own token.",
      "documentation": [
        "https://developer.atlassian.com/server/jira/platform/rest/v10000/intro/",
        "https://confluence.atlassian.com/enterprise/using-personal-access-tokens-1026032365.html"
      ],
      "lastReviewed": "2026-10-03",
      "baseURLExample": "https://jira.example.com",
      "auth": [
        { "id": "pat", "type": "bearer", "displayName": "Personal access token", "perUser": true },
        { "id": "basic", "type": "basic", "displayName": "Username and password", "perUser": true,
          "notes": "Only if your Jira allows basic auth for the REST API; prefer a token." }
      ],
      "connectionCheck": { "method": "GET", "path": "/rest/api/2/myself" },
      "tools": [
        {
          "name": "search_issues",
          "title": "Search issues",
          "description": "Search Jira issues with JQL. Returns key, summary, status, assignee, priority and last update.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "jql": { "type": "string", "description": "JQL, e.g. project = OPS AND status != Done ORDER BY updated DESC" },
              "maxResults": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 },
              "startAt": { "type": "integer", "default": 0, "minimum": 0 }
            },
            "required": ["jql"]
          },
          "request": {
            "method": "GET",
            "path": "/rest/api/2/search",
            "query": {
              "jql": "{jql}",
              "maxResults": "{maxResults}",
              "startAt": "{startAt}",
              "fields": "summary,status,assignee,priority,updated,issuetype"
            }
          },
          "response": {
            "pick": ["total", "startAt", "issues[].key", "issues[].fields.summary", "issues[].fields.status.name",
                     "issues[].fields.assignee.displayName", "issues[].fields.priority.name", "issues[].fields.updated",
                     "issues[].fields.issuetype.name"]
          }
        },
        {
          "name": "get_issue",
          "title": "Get issue",
          "description": "Read one issue with description, status, people, labels and the latest comments.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": { "issueKey": { "type": "string", "description": "Issue key, e.g. OPS-123" } },
            "required": ["issueKey"]
          },
          "request": {
            "method": "GET",
            "path": "/rest/api/2/issue/{issueKey}",
            "query": { "fields": "summary,description,status,assignee,reporter,priority,labels,created,updated,comment,issuetype,components" }
          },
          "response": {
            "pick": ["key", "fields.summary", "fields.description", "fields.status.name", "fields.assignee.displayName",
                     "fields.reporter.displayName", "fields.priority.name", "fields.labels", "fields.created", "fields.updated",
                     "fields.issuetype.name", "fields.components[].name",
                     "fields.comment.comments[].author.displayName", "fields.comment.comments[].created", "fields.comment.comments[].body"],
            "maxBytes": 60000
          }
        },
        {
          "name": "list_projects",
          "title": "List projects",
          "description": "Projects the account can see (key and name).",
          "readOnly": true,
          "inputSchema": { "type": "object", "properties": {} },
          "request": { "method": "GET", "path": "/rest/api/2/project" },
          "response": { "pick": ["[].key", "[].name"] }
        },
        {
          "name": "get_transitions",
          "title": "Available transitions",
          "description": "Workflow transitions currently possible for an issue (IDs for transition_issue).",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": { "issueKey": { "type": "string" } },
            "required": ["issueKey"]
          },
          "request": { "method": "GET", "path": "/rest/api/2/issue/{issueKey}/transitions" },
          "response": { "pick": ["transitions[].id", "transitions[].name", "transitions[].to.name"] }
        },
        {
          "name": "add_comment",
          "title": "Add comment",
          "description": "Add a comment to an issue (Jira wiki markup).",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "issueKey": { "type": "string" },
              "body": { "type": "string", "description": "Comment text" }
            },
            "required": ["issueKey", "body"]
          },
          "request": { "method": "POST", "path": "/rest/api/2/issue/{issueKey}/comment", "body": { "body": "{body}" } },
          "response": { "pick": ["id", "created"] }
        },
        {
          "name": "create_issue",
          "title": "Create issue",
          "description": "Create an issue in a project.",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "projectKey": { "type": "string" },
              "issueType": { "type": "string", "default": "Task" },
              "summary": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["projectKey", "summary"]
          },
          "request": {
            "method": "POST",
            "path": "/rest/api/2/issue",
            "body": {
              "fields": {
                "project": { "key": "{projectKey}" },
                "issuetype": { "name": "{issueType}" },
                "summary": "{summary}",
                "description": "{description}"
              }
            }
          },
          "response": { "pick": ["key", "self"] }
        },
        {
          "name": "transition_issue",
          "title": "Transition issue",
          "description": "Move an issue through its workflow (get the ID from get_transitions).",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "properties": { "issueKey": { "type": "string" }, "transitionId": { "type": "string" } },
            "required": ["issueKey", "transitionId"]
          },
          "request": {
            "method": "POST",
            "path": "/rest/api/2/issue/{issueKey}/transitions",
            "body": { "transition": { "id": "{transitionId}" } }
          }
        }
      ]
    },
    {
      "id": "confluence-dc",
      "displayName": "Confluence Data Center",
      "vendor": "Atlassian",
      "status": "experimental",
      "summary": "Search and read Confluence pages; create pages if allowed.",
      "notes": "Personal access tokens need Confluence 7.9+.",
      "documentation": [
        "https://developer.atlassian.com/server/confluence/confluence-server-rest-api/",
        "https://confluence.atlassian.com/enterprise/using-personal-access-tokens-1026032365.html"
      ],
      "lastReviewed": "2026-10-03",
      "baseURLExample": "https://confluence.example.com",
      "auth": [
        { "id": "pat", "type": "bearer", "displayName": "Personal access token", "perUser": true },
        { "id": "basic", "type": "basic", "displayName": "Username and password", "perUser": true }
      ],
      "connectionCheck": { "method": "GET", "path": "/rest/api/user/current" },
      "tools": [
        {
          "name": "search",
          "title": "Search content",
          "description": "Search pages and blog posts with CQL, e.g. type = page AND space = OPS AND text ~ \"vpn\".",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "cql": { "type": "string" },
              "limit": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 },
              "start": { "type": "integer", "default": 0, "minimum": 0 }
            },
            "required": ["cql"]
          },
          "request": {
            "method": "GET",
            "path": "/rest/api/content/search",
            "query": { "cql": "{cql}", "limit": "{limit}", "start": "{start}", "expand": "space,version" }
          },
          "response": {
            "pick": ["size", "totalSize", "results[].id", "results[].type", "results[].title", "results[].space.key",
                     "results[].version.when", "results[]._links.webui"]
          }
        },
        {
          "name": "get_page",
          "title": "Get page",
          "description": "Read a page's content (storage format), title, space and version.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": { "pageId": { "type": "string" } },
            "required": ["pageId"]
          },
          "request": {
            "method": "GET",
            "path": "/rest/api/content/{pageId}",
            "query": { "expand": "body.storage,version,space,ancestors" }
          },
          "response": {
            "pick": ["id", "title", "space.key", "version.number", "version.when", "ancestors[].title", "body.storage.value", "_links.webui"],
            "maxBytes": 80000
          }
        },
        {
          "name": "list_spaces",
          "title": "List spaces",
          "description": "Spaces the account can see.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": { "limit": { "type": "integer", "default": 50, "minimum": 1, "maximum": 500 } }
          },
          "request": { "method": "GET", "path": "/rest/api/space", "query": { "limit": "{limit}" } },
          "response": { "pick": ["results[].key", "results[].name", "results[].type"] }
        },
        {
          "name": "get_children",
          "title": "Child pages",
          "description": "Direct child pages of a page.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": { "pageId": { "type": "string" }, "limit": { "type": "integer", "default": 50, "maximum": 200 } },
            "required": ["pageId"]
          },
          "request": { "method": "GET", "path": "/rest/api/content/{pageId}/child/page", "query": { "limit": "{limit}" } },
          "response": { "pick": ["results[].id", "results[].title"] }
        },
        {
          "name": "create_page",
          "title": "Create page",
          "description": "Create a page in a space, optionally below a parent page. Body in Confluence storage format (XHTML).",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "spaceKey": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "parentId": { "type": "string" }
            },
            "required": ["spaceKey", "title", "body"]
          },
          "request": {
            "method": "POST",
            "path": "/rest/api/content",
            "body": {
              "type": "page",
              "title": "{title}",
              "space": { "key": "{spaceKey}" },
              "ancestors": [{ "id": "{parentId}" }],
              "body": { "storage": { "value": "{body}", "representation": "storage" } }
            }
          },
          "response": { "pick": ["id", "title", "_links.webui"] }
        }
      ]
    },
    {
      "id": "jamf-pro",
      "displayName": "Jamf Pro",
      "vendor": "Jamf",
      "status": "experimental",
      "summary": "Read computers, mobile devices, scripts, groups and policies.",
      "notes": "Use an API client with a read-only role. API clients are service accounts, so users can't bring their own.",
      "documentation": [
        "https://developer.jamf.com/jamf-pro/docs/client-credentials",
        "https://developer.jamf.com/jamf-pro/reference/jamf-pro-api"
      ],
      "lastReviewed": "2026-10-03",
      "baseURLExample": "https://yourorg.jamfcloud.com",
      "auth": [
        { "id": "apiclient", "type": "oauth2ClientCredentials", "displayName": "API client", "perUser": false, "tokenPath": "/api/oauth/token" }
      ],
      "connectionCheck": { "method": "GET", "path": "/api/v1/jamf-pro-version" },
      "tools": [
        {
          "name": "search_computers",
          "title": "Search computers",
          "description": "Computer inventory with an RSQL filter, e.g. general.name==\"MAC-*\" or hardware.serialNumber==\"C02XYZ\".",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "filter": { "type": "string", "description": "RSQL filter" },
              "section": { "type": "string", "enum": ["GENERAL", "HARDWARE", "OPERATING_SYSTEM", "USER_AND_LOCATION", "SECURITY", "APPLICATIONS"], "default": "GENERAL" },
              "pageSize": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 },
              "page": { "type": "integer", "default": 0, "minimum": 0 }
            }
          },
          "request": {
            "method": "GET",
            "path": "/api/v1/computers-inventory",
            "query": { "filter": "{filter}", "section": "{section}", "page-size": "{pageSize}", "page": "{page}" }
          },
          "response": { "maxBytes": 80000 }
        },
        {
          "name": "get_computer",
          "title": "Computer details",
          "description": "Full inventory record of one computer by Jamf ID.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": { "id": { "type": "string" } },
            "required": ["id"]
          },
          "request": { "method": "GET", "path": "/api/v1/computers-inventory-detail/{id}" },
          "response": { "maxBytes": 120000 }
        },
        {
          "name": "search_mobile_devices",
          "title": "Search mobile devices",
          "description": "Mobile devices with an RSQL filter.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "filter": { "type": "string" },
              "pageSize": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 },
              "page": { "type": "integer", "default": 0, "minimum": 0 }
            }
          },
          "request": {
            "method": "GET",
            "path": "/api/v2/mobile-devices",
            "query": { "filter": "{filter}", "page-size": "{pageSize}", "page": "{page}" }
          }
        },
        {
          "name": "list_scripts",
          "title": "Scripts",
          "description": "Scripts (name, category, contents) with an optional RSQL filter.",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "filter": { "type": "string" },
              "pageSize": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 }
            }
          },
          "request": { "method": "GET", "path": "/api/v1/scripts", "query": { "filter": "{filter}", "page-size": "{pageSize}" } },
          "response": { "maxBytes": 120000 }
        },
        {
          "name": "list_computer_groups",
          "title": "Computer groups",
          "description": "Smart and static computer groups.",
          "readOnly": true,
          "inputSchema": { "type": "object", "properties": {} },
          "request": { "method": "GET", "path": "/api/v1/computer-groups" }
        },
        {
          "name": "list_policies",
          "title": "Policies",
          "description": "All policies (ID and name, Classic API).",
          "readOnly": true,
          "inputSchema": { "type": "object", "properties": {} },
          "request": { "method": "GET", "path": "/JSSResource/policies" }
        },
        {
          "name": "get_policy",
          "title": "Policy details",
          "description": "One policy with scope, scripts, packages and triggers (Classic API).",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": { "id": { "type": "integer" } },
            "required": ["id"]
          },
          "request": { "method": "GET", "path": "/JSSResource/policies/id/{id}" },
          "response": { "maxBytes": 120000 }
        },
        {
          "name": "redeploy_framework",
          "title": "Redeploy management framework",
          "description": "Redeploy the Jamf management framework to a computer (by Jamf ID).",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "properties": { "id": { "type": "string" } },
            "required": ["id"]
          },
          "request": { "method": "POST", "path": "/api/v1/jamf-management-framework/redeploy/{id}" }
        }
      ]
    }
  ],
  "clients": [
    {
      "id": "claude-desktop",
      "displayName": "Claude Desktop",
      "status": "experimental",
      "transport": "stdio",
      "configPath": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "serversKey": "mcpServers",
      "entry": { "command": "{command}", "args": ["--stdio"] },
      "mimirHarness": "claude-desktop",
      "notes": "Claude Desktop starts macmcpd itself; it uses the same profile and the user's keychain credentials.",
      "documentation": ["https://modelcontextprotocol.io/docs/develop/connect-local-servers"]
    },
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "status": "experimental",
      "transport": "http",
      "configPath": "~/.claude.json",
      "serversKey": "mcpServers",
      "entry": { "type": "http", "url": "{url}", "headers": { "Authorization": "Bearer {token}" } },
      "mimirHarness": "claude-code",
      "notes": "Or: claude mcp add --transport http --scope user macmcp <url> --header \"Authorization: Bearer <token>\". Organisation-wide: deploy through Mimir (managed-mcp).",
      "documentation": ["https://code.claude.com/docs/en/mcp"]
    },
    {
      "id": "vscode",
      "displayName": "Visual Studio Code (Copilot Chat)",
      "status": "experimental",
      "transport": "http",
      "configPath": "~/Library/Application Support/Code/User/mcp.json",
      "serversKey": "servers",
      "entry": { "type": "http", "url": "{url}", "headers": { "Authorization": "Bearer {token}" } },
      "mimirHarness": "vscode-copilot",
      "documentation": ["https://code.visualstudio.com/docs/copilot/customization/mcp-servers"]
    },
    {
      "id": "cursor",
      "displayName": "Cursor",
      "status": "experimental",
      "transport": "http",
      "configPath": "~/.cursor/mcp.json",
      "serversKey": "mcpServers",
      "entry": { "url": "{url}", "headers": { "Authorization": "Bearer {token}" } },
      "mimirHarness": "cursor",
      "documentation": ["https://docs.cursor.com/context/mcp"]
    }
  ]
}
